{
  "name": "nowpayments-node",
  "version": "1.0.4",
  "description": "Full-featured TypeScript/Node.js SDK for NOWPayments cryptocurrency payment API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nowpayments",
    "crypto",
    "cryptocurrency",
    "bitcoin",
    "ethereum",
    "payment",
    "payment-gateway",
    "crypto-payments",
    "payments-api"
  ],
  "author": "Foisalislambd (https://github.com/Foisalislambd)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foisalislambd/nowpayments-package.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/foisalislambd/nowpayments-package/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/foisalislambd/nowpayments-package/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
